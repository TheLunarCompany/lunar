# Build context is the monorepo root: ignore everything, then allow what the mcpx image needs
*
!mcpx
!ai-gateway-shared/public

# Dependencies
**/node_modules
mcpx/npm-debug.log*
mcpx/yarn-debug.log*
mcpx/yarn-error.log*
**/*.tsbuildinfo

# Runtime data
mcpx/pids
mcpx/*.pid
mcpx/*.seed
mcpx/*.pid.lock

# Coverage directory used by tools like istanbul
mcpx/coverage

# nyc test coverage
mcpx/.nyc_output

# Grunt intermediate storage
mcpx/.grunt

# Bower dependency directory
mcpx/bower_components

# node-waf configuration
mcpx/.lock-wscript

# Compiled binary addons
mcpx/build/Release

# Dependency directories
mcpx/jspm_packages/

# TypeScript v1 declaration files
mcpx/typings/

# Optional npm cache directory
mcpx/.npm

# Optional eslint cache
mcpx/.eslintcache

# Optional REPL history
mcpx/.node_repl_history

# Output of 'npm pack'
mcpx/*.tgz

# Yarn Integrity file
mcpx/.yarn-integrity

# dotenv environment variables file
mcpx/.env
mcpx/.env.local
mcpx/.env.development.local
mcpx/.env.test.local
mcpx/.env.production.local

# parcel-bundler cache
mcpx/.cache
mcpx/.parcel-cache

# next.js build output
mcpx/.next

# nuxt.js build output
mcpx/.nuxt

# vuepress build output
mcpx/.vuepress/dist

# Serverless directories
mcpx/.serverless

# IDE
mcpx/.vscode
mcpx/.idea
mcpx/*.swp
mcpx/*.swo

# OS
mcpx/.DS_Store
mcpx/Thumbs.db

# Logs
mcpx/logs
mcpx/*.log

# Git
mcpx/.git
mcpx/.gitignore
mcpx/README.md
mcpx/.github

# Docker
mcpx/Dockerfile*
mcpx/docker-compose*
mcpx/.dockerignore

# Build artifacts
**/dist
mcpx/build