# Copy to .env and update values as needed

# Demo MCP clients for MCPX: `npm run start:claude` or `npm run start:gemini`.
# Each client reads only its own vars. Values set in the shell win over this file.

# =============================================================================
# Required env vars (for the client you run)
# =============================================================================

# Claude client: startup fails without it
ANTHROPIC_API_KEY=your-anthropic-api-key

# Gemini client: not checked at startup, but every request fails without it
GEMINI_API_KEY=your-gemini-api-key

# =============================================================================
# Optional, but recommended for local dev
# =============================================================================

# MCPX run from source listens on 9523 (MCPX_PORT in mcpx-server/.env).
# Default: http://localhost:9000, which matches the Docker image.
MCPX_HOST=http://localhost:9523

# Gemini client: defaults to true, which routes all Gemini API calls through a
# Lunar Gateway at LUNAR_GATEWAY_HOST. Set to false to call Gemini directly.
USE_LUNAR_GATEWAY=false

# Claude client: check Anthropic's model list for the latest available model
# and use that if possible: https://platform.claude.com/docs/en/models/overview
ANTHROPIC_MODEL=latest-claude-model-id

# Gemini client: check Google's model list for the latest available model
# and use that if possible: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL_ID=latest-gemini-model-id

# =============================================================================
# Optional env vars
# =============================================================================

# --- Claude client ---
# MAX_RESPONSE_TOKENS=500

# --- Gemini client ---
# Only with USE_LUNAR_GATEWAY=true
# LUNAR_GATEWAY_HOST=http://localhost:8000
# Uses SSE instead of Streamable HTTP. Leave unset to turn off: any value,
# even "false", turns it on.
# USE_SSE=
# Sent to MCPX as x-lunar-consumer-tag (consumer-based permissions)
# CONSUMER_TAG=anonymous
# Sent to MCPX as x-lunar-api-key; only needed when MCPX has auth enabled
# LUNAR_API_KEY=
