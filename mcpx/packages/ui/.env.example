# Copy to .env (or .env.local) and update values as needed

# No env vars are required: the dev defaults match MCPX (9523) and auth-bff
# (3002) run from source. These are read at dev/build time; the Docker image
# configures the UI from container env instead (scripts/generate-config.sh).

# =============================================================================
# Optional env vars
# =============================================================================

# --- MCPX connection ---
# Must match MCPX_PORT in mcpx-server/.env. Default: 9523 in dev, 9000 otherwise.
# VITE_MCPX_SERVER_PORT=9523
# Full MCPX URL; when set, used instead of <current host>:<VITE_MCPX_SERVER_PORT>
# VITE_MCPX_SERVER_URL=

# --- Connect to the mcpx-webapp stack (enterprise mode) ---
# Requires login through auth-bff and sends credentials with API calls.
# Pair with INSTANCE_KEY in mcpx-server/.env.
# VITE_ENABLE_ENTERPRISE=false
# Default: http://localhost:3002 in dev
# VITE_AUTH_BFF_URL=http://localhost:3002
# mcpx-webapp webserver, for admin-scoped routes (/obo); unset hides the
# end-edit button
# VITE_ADMIN_WEBSERVER_URL=http://localhost:3000

# --- Feature flags ---
# VITE_ENABLE_PERMISSIONS=false
# VITE_ENABLE_CAPABILITIES_UI=false
# VITE_UI_SIDEBAR_RESTRUCTURE=false
# VITE_SHOW_MCP_SERVERS=false
# VITE_IS_BOOMI=false
# VITE_ENABLE_PENDO=false

# Text for a confirmation checkbox shown when adding servers (max 200 chars);
# unset = no checkbox
# VITE_ADD_SERVER_CHECKBOX=

# --- Dev only ---
# Serve API responses from MSW mocks
# VITE_MSW_ENABLED=false
# Mock data for the tools page
# VITE_MCPX_MOCK_TOOLS=false
# Monaco model URI for the mcp.json editor
# VITE_MCP_JSON_FILE_PATH=file:///mcp.json
