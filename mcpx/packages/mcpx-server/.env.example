# Copy to .env and update values as needed

# =============================================================================
# Required env vars
# =============================================================================

# Reported in logs and telemetry
VERSION=dev
INSTANCE_ID=dev-instance

# =============================================================================
# Optional, but recommended for local dev
# =============================================================================

# Default 3000 clashes with the mcpx-webapp webserver
SERVE_METRICS_PORT=9002

# Default false blocks stdio MCP servers (UI add is rejected, spawning blocked)
ENABLE_STDIO_MCP_SERVERS=true

# =============================================================================
# Optional env vars
# =============================================================================

# NODE_ENV=development
# LOG_LEVEL= error | warn | info | http | verbose | debug | silly
# ACCESS_LOG_LEVEL=debug
# Comma-separated: client-access-log | audit-log-persistence | detailed-tool-listings
# LOG_HIDE_TAGS=
# Comma-separated keys redacted from logs
# LOG_REDACT_KEYS=env

# --- Ports and URLs ---
# Must match VITE_MCPX_SERVER_PORT in ui/.env
# MCPX_PORT=9523
# MCPX_SERVER_URL=http://127.0.0.1:9523
# UI_PORT=5173
# UI_URL=http://127.0.0.1:5173
# ENABLE_METRICS=true

# --- Connect to the hub (enterprise mode) ---
# Leave unset for standalone mode (config from APP_CONFIG_PATH/SERVERS_CONFIG_PATH).
# When set, MCPX runs in enterprise mode: config, tokens and servers come from
# the hub. Must be the ID of an existing setup owner in the webapp database.
# INSTANCE_KEY=
# INSTANCE_NAME=
# HUB_WS_URL=ws://127.0.0.1:3030
# ENFORCE_HUB_CONNECTION=false
# HUB_CONNECTION_TIMEOUT_MS=20000
# HUB_RECONNECT_DELAY_MAX_MS=10000

# --- Standalone config files (relative to the working directory) ---
# Missing app config falls back to built-in defaults
# APP_CONFIG_PATH=config/app.yaml
# SERVERS_CONFIG_PATH=config/mcp.json
# READ_TARGET_SERVERS_FROM_FILE=true

# --- Security ---
# API key clients must present
# AUTH_KEY=
# Comma-separated CIDR ranges allowed to connect; unset = all
# ALLOWED_IP_RANGES=
# Comma-separated; unset = the UI dev server (http://localhost:5173)
# CORS_ORIGINS=
# Base URL for OAuth callbacks; unset = http://127.0.0.1:<MCPX_PORT>
# OAUTH_CALLBACK_BASE_URL=
# OAUTH_DISCOVERY_TIMEOUT_MILLIS=3000

# --- Capabilities and policy ---
# STRICTNESS_REQUIRED=false
# ENABLE_PROMPT_CAPABILITY=false
# ENABLE_RESOURCE_CAPABILITY=false
# Capability scoping via enabled skills instead of permissions + tool groups
# ENABLE_SKILL_SCOPING=false
# DIND_ENABLED=false
# Pass MCPX's own environment to stdio MCP servers it spawns
# STDIO_INHERIT_PROCESS_ENV=false
# ENABLE_CONTROL_PLANE_REST=true

# --- Downstream sessions (agents connecting to MCPX) ---
# PING_INTERVAL_MS=5000
# PING_MAX_CONSECUTIVE_TIMEOUTS=3
# DOWNSTREAM_KEEPALIVE_INTERVAL_MS=25000
# PROBE_CLIENTS_GRACE_LIVENESS_PERIOD_MS=10000
# AGENT_SESSION_TTL_MIN=30
# KEEPALIVE_SWEEP_INTERVAL_MIN=1
# Minutes an offline agent stays on the dashboard
# AGENT_DISCONNECTED_RETENTION_MIN=60
# ENABLE_STREAMABLE_EVENT_STORE=false
# STREAMABLE_EVENT_STORE_MAX_EVENT_AGE_MS=300000

# --- Upstream MCP servers ---
# See .documentation/upstream-liveness.md
# CONNECTION_TIMEOUT_MS=180000
# UPSTREAM_PING_INTERVAL_MS=30000
# UPSTREAM_PING_TIMEOUT_MS=10000
# UPSTREAM_PING_FAILURE_THRESHOLD=3
# UPSTREAM_RECONNECT_BASE_DELAY_MS=30000
# ENABLE_TOOL_CALL_CACHE=false
# TOOL_CALL_CACHE_TTL_MS=300000
# TOOL_CALL_CACHE_MAX_ENTRIES=1000

# --- Hosted MCP servers: identity token verification (passed to child processes) ---
# MCPX_AUTH_JWKS_URI=
# MCPX_AUTH_JWT_ISSUER=
# MCPX_AUTH_JWT_AUDIENCE=

# --- Usage reporting ---
# USAGE_STATS_INTERVAL_MS=60000
# TOOL_CALL_BATCH_INTERVAL_MS=10000

# --- Audit log ---
# ENABLE_AUDIT_LOG=true
# Default: <working directory>/audit-logs
# AUDIT_LOG_DIR=
# AUDIT_LOG_RETENTION_HOURS=336
# AUDIT_LOG_FLUSH_INTERVAL_IN_SEC=5

# --- Telemetry ---
# When true, telemetry logs are shipped to Loki at LOKI_HOST
# LUNAR_TELEMETRY=true
# LOKI_HOST=log-collector-dev.lunar.dev
# LOKI_USER=
# LOKI_PASSWORD=
# LUNAR_API_KEY=

# --- Sandbox analysis pods only ---
# IS_SANDBOX_ANALYSIS=false
# cl100k_base | o200k_base | p50k_base | p50k_edit | r50k_base
# TOKENIZER_ENCODING=cl100k_base
# LLM_REQUEST_TIMEOUT_MS=20000
